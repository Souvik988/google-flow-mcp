# ==============================
# Google Flow MCP Server Config
# ==============================
# Copy to .env and adjust. No Google passwords/cookies/OTP ever go in here:
# authentication is a one-time manual sign-in in a visible Chrome window.

# Flow studio URL (Google-owned HTTPS only).
FLOW_STUDIO_URL=https://flow.google.com/

# Persistent job system (workspace-relative paths).
FLOW_OUTPUT_DIR=outputs
FLOW_STATE_DIR=.flow-state
# Attach to a manually-authenticated Chrome instead of launching one:
# FLOW_BROWSER_CDP_URL=http://127.0.0.1:9222
# FLOW_BROWSER_PROFILE_DIR=C:/Users/YOU/AppData/Local/GoogleFlowMcp/profile
# FLOW_BROWSER_EXECUTABLE_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
FLOW_MAX_CONCURRENCY=1
FLOW_GENERATION_TIMEOUT_MS=720000
FLOW_PROGRESS_STALL_MS=90000
FLOW_INITIAL_POLL_MS=2000
FLOW_MAX_POLL_MS=15000
FLOW_MAX_SUBMISSION_RETRIES=3
FLOW_MAX_GENERATION_ATTEMPTS=2
FLOW_CAPTURE_DIAGNOSTICS=false
FLOW_BROWSER_LAUNCH_TIMEOUT_MS=45000

# Models: gemini-omni-flash | veo-3.1-fast | veo-3.1-quality
FLOW_DEFAULT_VIDEO_MODEL=gemini-omni-flash

# Post-processing (defaults shown; uncomment to override).
# FLOW_WATERMARK_REMOVAL=true          (on by default for every job)
# FLOW_WATERMARK_METHOD=auto           (auto | unblend | inpaint | ffmpeg)

# Optional explicit binaries for the finishing engines.
# FFPROBE_PATH=
# FFMPEG_PATH=
# PYTHON_PATH=

# Local asset API (optional): /connect setup page + /mcp HTTP endpoint.
FLOW_HTTP_HOST=127.0.0.1
FLOW_HTTP_PORT=4318
FLOW_HTTP_TOKEN=
# stdio (default) | http | both
FLOW_TRANSPORT=stdio

# Legacy Google Apps Script bridge (optional, only if you deployed one).
# FLOW_BRIDGE_URL=
# FLOW_BRIDGE_TOKEN=
# DEFAULT_VIDEO_FOLDER_ID=
