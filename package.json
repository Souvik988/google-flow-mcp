{
  "name": "google-flow-mcp",
  "version": "2.1.0",
  "description": "Google Flow (Veo) MCP server: durable video + image generation jobs through your own Google account, automatic watermark-free finishing, and local IDE delivery.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/index.js",
    "mcp": "node dist/asset-mcp-main.js",
    "host": "node dist/asset-host-main.js",
    "recover": "node dist/recovery-main.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/asset-mcp-main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "puppeteer": "^24.28.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "keywords": ["mcp", "google-flow", "veo", "gemini", "video-generation", "image-generation", "ai-media"],
  "license": "MIT"
}
